<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/app_name">

    <Preference
        android:key="statusbar"
        android:title="@string/statusbar_title"
        android:summary="@string/statusbar_summary"
        android:icon="@drawable/ic_statusbar"
        android:fragment="org.graphite.parts.statusbar.StatusBarFragment" />

    <Preference
        android:key="lockscreen"
        android:title="@string/lockscreen_title"
        android:summary="@string/lockscreen_summary"
        android:icon="@drawable/ic_lockscreen"
        android:fragment="org.graphite.parts.lockscreen.LockScreenFragment" />

    <Preference
        android:key="powermenu"
        android:title="@string/power_menu_title"
        android:summary="@string/power_menu_summary"
        android:icon="@drawable/ic_power"
        android:fragment="org.graphite.parts.powermenu.PowerMenuFragment" />

    <Preference
        android:key="secure_override"
        android:title="@string/secure_override_title"
        android:summary="@string/secure_override_summary"
        android:icon="@drawable/ic_screenshot"
        android:fragment="org.graphite.parts.privacy.SecureOverrideFragment" />

    <Preference
        android:key="play_keybox"
        android:title="@string/keybox_title"
        android:summary="@string/keybox_summary"
        android:icon="@drawable/ic_keybox"
        android:fragment="org.graphite.parts.keybox.KeyboxFragment" />

    <Preference
        android:key="nowplaying"
        android:title="@string/nowplaying_title"
        android:summary="@string/nowplaying_summary"
        android:icon="@drawable/ic_nowplaying"
        android:fragment="org.graphite.parts.nowplaying.NowPlayingFragment" />

    <Preference
        android:title="@string/weather_title"
        android:summary="@string/weather_summary"
        android:icon="@drawable/ic_weather">
        <intent
            android:action="org.graphite.weather.SETTINGS"
            android:targetPackage="org.graphite.weather" />
    </Preference>

    <Preference
        android:key="about"
        android:title="@string/about_title"
        android:selectable="false" />
</PreferenceScreen>
